# =====================================================================
# ThreadAI backend — environment template
# Copy to `.env` and fill in real values. NEVER commit the real .env.
#   cp .env.example .env
# =====================================================================

# --- Server ---
PORT=5000
NODE_ENV=development

# --- MySQL ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_root_password_here
DB_NAME=threadai_db

# --- Auth (JWT stored in an httpOnly cookie) ---
# Generate a long random value, e.g.: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=1d
COOKIE_SECURE=false

# --- CORS ---
# Comma-separated list of allowed frontend origins (only needed if you
# serve the frontend from a different origin, e.g. python -m http.server)
CORS_ORIGIN=http://127.0.0.1:8000,http://localhost:8000

# --- Initial admin account (used ONLY by `npm run create-admin`) ---
ADMIN_NAME=ThreadAI Administrator
ADMIN_EMAIL=admin@threadai.local
ADMIN_PASSWORD=change_this_admin_password

# --- AI clothing analysis (Phase 3) ---
# Google Gemini API key (vision-capable). Get one free at
#   https://aistudio.google.com/apikey
# Without it, the backend still runs: POST /api/analyze returns 503
# with a clear "not configured" message and the UI shows the notice.
GEMINI_API_KEY=
# Optional overrides:
#GEMINI_MODEL=gemini-3.8-flash
#AI_TIMEOUT_MS=25000
